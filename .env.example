# =====================================================================
# .env.example — Plantilla de variables para Docker Compose (LOCAL)
# =====================================================================
#
# 1. Copiar este archivo a `.env` en la misma carpeta:
#       Windows:   Copy-Item .env.example .env
#       macOS/Linux: cp .env.example .env
#
# 2. Rellenar los valores marcados como CAMBIAR_ESTO con los reales
#    (o usar el `.env` pre-rellenado que Kevin entrega al tribunal).
#
# 3. Lanzar:
#       docker compose up --build
#
# El archivo .env NO se sube al repositorio (esta en .gitignore).
# Solo el .env.example se versiona.
# =====================================================================


# ---------------------------------------------------------------------
# MySQL — contrasena del usuario root del contenedor MySQL local.
# ---------------------------------------------------------------------
# Esta contrasena es SOLO para la BD que vive dentro de Docker; no es
# ninguna contrasena real. Puedes inventartela. Caracteres aceptados:
# letras, numeros y simbolos basicos (sin comillas).
MYSQL_ROOT_PASSWORD=cambia-esto-por-cualquier-contrasena


# ---------------------------------------------------------------------
# JWT — clave secreta para firmar tokens de autenticacion.
# ---------------------------------------------------------------------
# Debe ser una cadena en base64 de al menos 256 bits.
# Para generar una nueva:    openssl rand -base64 64
# Si solo es para ver la app funcionar en local, el valor por defecto
# de mas abajo sirve (es el que usamos en el TFG).
VICTORINO_JWT_SECRET=Y2FtYmlhbWVlbnByb2R1Y2Npb25fY2xhdmVfc2VjcmV0YV92aWN0b3Jpbm9fc3R5bGVfMjAyNg==


# ---------------------------------------------------------------------
# Gmail SMTP — para que la recuperacion de contrasena envie correos.
# ---------------------------------------------------------------------
# La contrasena NO es la real de Gmail; es una "app password" generada
# en Cuenta Google -> Seguridad -> Verificacion en dos pasos ->
# Contrasenas de aplicaciones.
#
# Kevin entrega al tribunal estas credenciales en un correo / sobre
# aparte para no commitearlas. En caso de no tenerlas, el resto de la
# app funcionara salvo el flujo de recuperacion de contrasena.
SPRING_MAIL_USERNAME=peluqueria.victorinostyle@gmail.com
SPRING_MAIL_PASSWORD=CAMBIAR_ESTO_POR_APP_PASSWORD_GMAIL


# ---------------------------------------------------------------------
# Admin de prueba — se crea automaticamente al arrancar el backend.
# ---------------------------------------------------------------------
# Credenciales:
#   Correo:      victorino@admin.com
#   Contrasena:  (la que pongas aqui)
#
# Puede dejarse igual para la demo del TFG.
VICTORINO_ADMIN_PRUEBA_PASSWORD=Admin1234!


# ---------------------------------------------------------------------
# Firebase Cloud Messaging — JSON del service account.
# ---------------------------------------------------------------------
# Pegar el JSON entero del service account en UNA SOLA LINEA (sin saltos
# de linea reales; los \n dentro de private_key son literales).
#
# Como obtenerlo (si Kevin no te lo da):
#   Firebase Console -> Configuracion del proyecto -> Cuentas de servicio
#   -> Generar nueva clave privada -> descarga el JSON.
#
# Si lo dejas vacio, las notificaciones push no funcionaran pero el
# resto de la app si: el backend logueara un aviso y seguira arrancando.
VICTORINO_FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"victorino-style","private_key_id":"CAMBIAR","private_key":"-----BEGIN PRIVATE KEY-----\nCAMBIAR\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-fbsvc@victorino-style.iam.gserviceaccount.com","client_id":"CAMBIAR","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"CAMBIAR","universe_domain":"googleapis.com"}

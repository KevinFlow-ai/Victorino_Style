# =====================================================================
# .env.example - Plantilla de variables de entorno del Backend
# =====================================================================
#
# Este archivo es UNICAMENTE una referencia. No contiene secretos reales.
# En LOCAL no hace falta tocar nada (application.properties tiene defaults
# para todas estas variables). En RAILWAY se configuran en la pestana
# "Variables" del servicio Backend.
#
# Sintaxis: VARIABLE=valor (sin comillas, sin espacios alrededor del =).
# =====================================================================


# ---------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------
# Railway inyecta PORT automaticamente. En local cae al 8080.
# No hace falta definirlo manualmente en Railway.
PORT=8080


# ---------------------------------------------------------------------
# BASE DE DATOS (MySQL)
# ---------------------------------------------------------------------
# En Railway, usar referencias al servicio MySQL:
#   SPRING_DATASOURCE_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?useSSL=false&serverTimezone=Europe/Madrid&allowPublicKeyRetrieval=true
#   SPRING_DATASOURCE_USERNAME=${{MySQL.MYSQLUSER}}
#   SPRING_DATASOURCE_PASSWORD=${{MySQL.MYSQLPASSWORD}}
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/victorino_style_bbdd_tfg_2dam_2025_2026_puig?useSSL=false&serverTimezone=Europe/Madrid&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=cambia-esto


# ---------------------------------------------------------------------
# JWT (autenticacion)
# ---------------------------------------------------------------------
# Clave base64 de al menos 256 bits. Generar con:
#   openssl rand -base64 64
# DEBE ser distinta en cada entorno (local/produccion).
VICTORINO_JWT_SECRET=cambia-esto-por-una-cadena-base64-de-al-menos-256-bits


# ---------------------------------------------------------------------
# SMTP (recuperacion de contrasena por correo)
# ---------------------------------------------------------------------
# Por defecto se usa Gmail con contrasena de aplicacion (NO la real).
# Generar contrasena de aplicacion en: Cuenta Google > Seguridad > 2FA.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=peluqueria.victorinostyle@gmail.com
SPRING_MAIL_PASSWORD=contrasena-aplicacion-gmail


# ---------------------------------------------------------------------
# ADMIN DE PRUEBA
# ---------------------------------------------------------------------
# Se crea al arrancar si no existe (idempotente). Util para demos.
# Para desactivarlo en produccion: VICTORINO_ADMIN_PRUEBA_ACTIVO=false
VICTORINO_ADMIN_PRUEBA_ACTIVO=true
VICTORINO_ADMIN_PRUEBA_CORREO=victorino@admin.com
VICTORINO_ADMIN_PRUEBA_PASSWORD=Admin1234!


# ---------------------------------------------------------------------
# UPLOADS (fotos de servicios, empleados, clientes)
# ---------------------------------------------------------------------
# En local: ruta relativa "uploads".
# En Railway: punto de montaje del Volume, p.ej. /app/uploads.
VICTORINO_UPLOADS_DIRECTORIO=uploads


# ---------------------------------------------------------------------
# CORS (origenes adicionales permitidos)
# ---------------------------------------------------------------------
# Lista separada por coma de origenes que pueden llamar al API.
# Los origenes de desarrollo (localhost, ngrok, red WiFi) ya van incluidos
# por defecto en CorsConfig.java. Aqui SOLO se anaden los de produccion.
# Ejemplo: https://victorino-frontend-production.up.railway.app
VICTORINO_CORS_ORIGENES_EXTRA=


# ---------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (notificaciones push)
# ---------------------------------------------------------------------
# Dos formas (FirebaseConfig prueba la _JSON primero, luego la _PATH):
#
#  - En LOCAL: archivo en resources/ (no commiteado al repo).
#      VICTORINO_FIREBASE_CREDENTIALS_PATH=classpath:firebase/victorino-firebase-key.json
#
#  - En RAILWAY (recomendado): pegar el JSON entero del service account
#    como variable de entorno. Railway acepta valor multilinea.
#      VICTORINO_FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
#
# Si ninguna esta presente, push FCM queda deshabilitado pero la app arranca.
VICTORINO_FIREBASE_CREDENTIALS_JSON=
VICTORINO_FIREBASE_CREDENTIALS_PATH=classpath:firebase/victorino-firebase-key.json
VICTORINO_FIREBASE_PROJECT_ID=victorino-style

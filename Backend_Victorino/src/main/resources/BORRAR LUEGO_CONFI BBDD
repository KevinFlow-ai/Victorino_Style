# ====================================
# CONFIGURACIÓN DE LA BASE DE DATOS
# ====================================

spring.datasource.url=jdbc:mysql://localhost:3306/Escuela_Hibernate_JPA_Proyecto_bbdd_teresa
spring.datasource.username=root
spring.datasource.password=1234
#Usamos el drive de la dependencia de mysql
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver




# ================================
# JPA / HIBERNATE
# ================================

# Mostrar las consultas SQL en consola
spring.jpa.show-sql=true

# Formatear las consultas SQL Para que las consultas se vean mas bonita
spring.jpa.properties.hibernate.format_sql=true



# Aquí se puede poner create-drop | create | update | validate | none
# create: Cada vez que arranca: borra todas las tablas y crea todoo desde cero. El riesgo borra datos
# create-drop: igual que create, pero al cerrar la aplicación, borra las tablas.. El riesgo borra datos
# update: Hibernate actualiza la base de datos automáticamente para que coincida con tus entidades:. Puede romper el esquema
# validate: Hibernate solo comprueba que las entidades coinciden con la estructura de la base de datos.
# none: Hibernate no toca la base de datos. Ideal cuando ya tienes el esquema creado manualmente o por migraciones
spring.jpa.hibernate.ddl-auto=validate

# 1. Fuerza a Hibernate a usar los nombres exactos que pusiste en @Table y @Column en el entity de Alumno:
# explicado en el document ode problemas con las tablas
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
spring.jpa.hibernate.naming.implicit-strategy=org.hibernate.boot.model.naming.ImplicitNamingStrategyLegacyJpaImpl



MAIN PARA COMPROBAR QUE SE CONECTA A LA BBDD

package org.victorino_style;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.boot.CommandLineRunner;
import org.springframework.context.annotation.Bean;

import javax.sql.DataSource;
import java.sql.Connection;

@SpringBootApplication
public class BackendVictorinoApplication {

    public static void main(String[] args) {
        SpringApplication.run(BackendVictorinoApplication.class, args);
    }

    // Prueba de conexión a la base de datos al iniciar la aplicación
    @Bean
    public CommandLineRunner testDatabaseConnection(DataSource dataSource) {
        return args -> {
            System.out.println("🔍 Probando conexión a la base de datos...");

            try (Connection connection = dataSource.getConnection()) {
                System.out.println("✅ Conexión establecida correctamente con la BBDD: "
                        + connection.getMetaData().getDatabaseProductName()
                        + " " + connection.getMetaData().getDatabaseProductVersion());
            } catch (Exception e) {
                System.err.println("❌ Error al conectar con la base de datos:");
                e.printStackTrace();
            }
        };
    }
}